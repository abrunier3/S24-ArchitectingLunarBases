#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "CargoRelayMission"
    {
        custom string part:name = "CargoRelayMission"
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Xform "CargoRover"
    {
        custom string attributes = "{'maxCapacity': 8.0, 'hoursPerKm': 0.75, 'energyPerKmPerKg': 0.008}"
        custom string dimensions = "{'size_m': {'length': 4.0, 'width': 2.5, 'height': 2.0}, 'metersPerUnit': 1, 'upAxis': 'Z'}"
        custom string part:name = "CargoRover"
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Xform "CargoSource"
    {
        custom string attributes = "{'supplyRate': 12.0}"
        custom string dimensions = "{'size_m': {'length': 6.0, 'width': 6.0, 'height': 4.0}, 'metersPerUnit': 1, 'upAxis': 'Z'}"
        custom string part:name = "CargoSource"
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-1592.5, -55, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Xform "ForwardDepot"
    {
        custom string attributes = "{'storageCapacity': 100.0}"
        custom string dimensions = "{'size_m': {'length': 5.0, 'width': 5.0, 'height': 3.0}, 'metersPerUnit': 1, 'upAxis': 'Z'}"
        custom string part:name = "ForwardDepot"
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-492.5, 245, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }

    def Xform "HabitatConsumer"
    {
        custom string dimensions = "{'size_m': {'length': 10.0, 'width': 8.0, 'height': 5.0}, 'metersPerUnit': 1, 'upAxis': 'Z'}"
        custom string part:name = "HabitatConsumer"
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (557.5, -155, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
    }
}

