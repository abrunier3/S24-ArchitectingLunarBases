        int[] faceVertexIndices = [0, 1, 2, 3]
        rel material:binding = </World/Looks/Lunar_Surface_Material> (
            bindMaterialAs = "weakerThanDescendants"
        )
        point3f[] points = [(-2500, -2500, 0), (2500, -2500, 0), (2500, 2500, 0), (-2500, 2500, 0)]
