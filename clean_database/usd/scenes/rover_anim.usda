#usda 1.0
(
    startTimeCode = 0
    endTimeCode = 40
    timeCodesPerSecond = 1
)

over "World"
{
    ########################################
    # REGOLITH ROVER (moves first)
    ########################################
    over "RegolithRover"
    {
        double3 xformOp:translate.timeSamples = {
            0:  (2500, 2000, -140),
            5:  (2625, 1625, -155),
            10: (2750, 1250, -170),
            15: (2875, 875,  -185),
            20: (3000, 500,  -200),

            25: (3000, 500,  -200),
            30: (3000, 500,  -200),
            35: (3000, 500,  -200),
            40: (3000, 500,  -200)
        }
    }

    ########################################
    # LOX ROVER (moves second)
    ########################################
    over "LOXRover"
    {
        double3 xformOp:translate.timeSamples = {
            0:  (3000, 400, -130),
            5:  (3000, 400, -130),
            10: (3000, 400, -130),
            15: (3000, 400, -130),

            20: (3000, 500,  -200),
            25: (3075, -250, -195),
            30: (3150, -1000, -190),
            35: (3225, -1750, -185),
            40: (3300, -2500, -180)
        }
    }
}
